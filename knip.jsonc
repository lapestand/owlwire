{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points per workspace. On top of these, knip adds what it finds on its own: package.json `bin`,
  // `exports` (mapped from dist to src), the files that package.json scripts run, the files the GitHub workflows run
  // (for example scripts/check-commit-msg.mjs), and config files of the tools it knows (vitest, tsup, vite,
  // drizzle-kit, biome). Test files are entries through the vitest plugin and the root vitest.config.ts projects.
  "workspaces": {
    ".": {
      // stryker.config.mjs names it as the test config (vitest.configFile), which knip does not follow.
      "entry": ["vitest.mutation.config.ts"],
      "ignoreDependencies": [
        // dependency-cruiser loads it as its parser (`parser: 'swc'` in .dependency-cruiser.cjs).
        "@swc/core"
      ]
    },
    "apps/server": {
      "ignoreDependencies": [
        // tsup bundles the workspace packages but keeps their npm dependencies external, so the server lists the
        // runtime dependencies of @owlwire/db (drizzle-orm) and @owlwire/adapter-telegram (grammy) itself.
        // pnpm deploy --prod installs only what the server package declares.
        "drizzle-orm",
        "grammy",
        // Built first through turbo's ^build, then copied into public/ by scripts/copy-assets.mjs.
        "@owlwire/web",
        // Installed ahead of the account and sign-in code that imports them. Remove each entry in the change that
        // adds its first import: better-auth with the auth setup, the passkey plugin with two-factor and passkey
        // support.
        "better-auth",
        "@better-auth/passkey"
      ]
    },
    "apps/web": {},
    "packages/db": {
      // Installed ahead of the auth adapter that imports it; remove this entry together with that change.
      "ignoreDependencies": ["better-auth"]
    },
    "packages/*": {},
    "packages/adapters/*": {}
  }
}
