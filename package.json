{
  "name": "owlwire",
  "version": "0.35.59",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/check-system-guc.mjs && node scripts/check-env.mjs && knip --no-progress",
    "format": "biome check --write .",
    "depcruise": "node scripts/depcruise.mjs",
    "test": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project int --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests && node scripts/coverage-summary.mjs",
    "test:mutation": "stryker run",
    "bump": "node scripts/bump-version.mjs",
    "dev": "turbo run dev"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "fast-check": "^4.10.2",
    "knip": "^6.41.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
