{
  "name": "@owlwire/testing",
  "version": "0.35.78",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "source": "./src/fixtures/index.ts",
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project unit --passWithNoTests",
    "test:int": "vitest run --config ../../vitest.config.ts --project int --passWithNoTests"
  },
  "dependencies": {
    "@owlwire/core": "workspace:*",
    "@owlwire/db": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@owlwire/crypto": "workspace:*",
    "@types/pg": "^8.23.1"
  }
}
