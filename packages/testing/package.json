{
  "name": "@owlwire/testing",
  "version": "0.36.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --config ../../vitest.config.ts --project unit --passWithNoTests",
    "test:int": "vitest run --config ../../vitest.config.ts --project int --passWithNoTests"
  },
  "dependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
