{
  "name": "@owlwire/db",
  "version": "0.25.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate": {
      "source": "./src/migrate-all.ts",
      "types": "./dist/migrate-all.d.ts",
      "import": "./dist/migrate-all.js"
    },
    "./system": {
      "source": "./src/system/index.ts",
      "types": "./dist/system/index.d.ts",
      "import": "./dist/system/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts --project unit --passWithNoTests",
    "test:int": "vitest run --config ../../vitest.config.ts --project int --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@owlwire/core": "workspace:*",
    "@owlwire/crypto": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "graphile-worker": "^0.18.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@owlwire/testing": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
