# Password of the Postgres owner role "owlwire"; letters and digits only (it is embedded in a URL): openssl rand -hex 16
OWLWIRE_DB_OWNER_PASSWORD=

# Application role (subject to row level security). `owlwire migrate` creates it with this password when it does
# not exist; an existing role's password is left untouched. Letters and digits only (it is embedded in a URL):
# openssl rand -hex 24. Upgrading an existing install: see UPGRADING.md.
OWLWIRE_DB_APP_PASSWORD=

# Auth role "owlwire_auth": the only role that can read sessions, password hashes and sign-in tokens; the sign-in
# code alone connects as it. `owlwire migrate` creates it with this password when it does not exist (an existing
# role's password is left untouched). Letters and digits only (it is embedded in a URL): openssl rand -hex 24.
# Upgrading an existing install: see UPGRADING.md.
OWLWIRE_DB_AUTH_PASSWORD=

# Local development only, never in production: "true" lets serve start when the application database role is not
# subject to row level security (single role, superuser), logging each reason as a warning. Ignored when
# NODE_ENV=production, which the Owlwire image sets. Leave it false.
OWLWIRE_ALLOW_INSECURE_DB_ROLE=false

# Instance key encryption key, base64 of 32 bytes: openssl rand -base64 32
OWLWIRE_KEK=
OWLWIRE_KEK_VERSION=1
# KEK rotation: put the new key in OWLWIRE_KEK and its version in OWLWIRE_KEK_VERSION, the old one as
# "<old version>:<base64>" in OWLWIRE_KEK_PREVIOUS, restart, run `docker compose exec owlwire owlwire keys rotate`;
# once it prints "OWLWIRE_KEK_PREVIOUS can be removed", remove OWLWIRE_KEK_PREVIOUS and restart.
OWLWIRE_KEK_PREVIOUS=

OWLWIRE_LOG_LEVEL=info
# Public URL of this instance: an http:// or https:// origin only, no path, query or credentials (for example
# https://owl.example.com). Sign-in and mail links are built from it, and production needs https://: the session
# cookie is then marked Secure, and verification and reset emails are not sent with http:// links in production.
# Register <public url>/api/auth/callback/<provider> as the redirect URI (provider is discord, google or github)
# with each social sign-in provider.
# Empty falls back to http://localhost:<OWLWIRE_PORT>, which only works for local use.
OWLWIRE_PUBLIC_URL=

# Secret that signs sessions and encrypts stored sign-in tokens, at least 32 characters and not repetitive:
# openssl rand -base64 32
# Required. Changing it signs every user out and makes stored sign-in tokens unreadable.
OWLWIRE_AUTH_SECRET=

# Outgoing mail for verification and password reset links. Empty disables mail.
# Format smtp://user:password@host:587 or smtps://user:password@host:465. Percent-encode special characters in
# the user name and password (@ as %40, : as %3A, / as %2F).
OWLWIRE_SMTP_URL=
# Sender address, required when OWLWIRE_SMTP_URL is set, for example: Owlwire <no-reply@example.com>
OWLWIRE_SMTP_FROM=

# Optional social sign-in. A provider is enabled only when both its client id and secret are set.
# Register <OWLWIRE_PUBLIC_URL>/api/auth/callback/<discord|google|github> as the redirect URL at the provider.
# Discord sign-in uses the Discord bot application's client id and secret; the bot token itself is a separate
# setting.
OWLWIRE_DISCORD_CLIENT_ID=
OWLWIRE_DISCORD_CLIENT_SECRET=
OWLWIRE_GOOGLE_CLIENT_ID=
OWLWIRE_GOOGLE_CLIENT_SECRET=
OWLWIRE_GITHUB_CLIENT_ID=
OWLWIRE_GITHUB_CLIENT_SECRET=

# HTTP port inside the container (1-65535; also used for the localhost fallback of OWLWIRE_PUBLIC_URL). The compose file publishes 8080, so change its ports entry along with it.
OWLWIRE_PORT=8080
# Reverse proxies whose X-Forwarded-For header is trusted, as a comma-separated list of addresses or CIDR ranges
# (for example 10.0.0.5 or 172.18.0.0/16). Sign-in rate limits count per client address. Empty: forwarded headers are
# ignored and the TCP peer is the client, which behind a proxy makes every user share the proxy's limit. List only
# the proxy's own address or subnet, never a range that also covers clients.
OWLWIRE_TRUSTED_PROXIES=
# Process role: all, api or worker. The compose file starts `serve --role all`, and --role takes precedence.
OWLWIRE_ROLE=all
# Edition config file inside the container. Empty uses /etc/owlwire/owlwire.yaml when that file exists.
OWLWIRE_CONFIG=

# Optional shared Telegram bot (not used yet; shared bot delivery comes in a later release)
OWLWIRE_TELEGRAM_BOT_TOKEN=
