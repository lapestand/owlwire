# Password of the Postgres owner role "owlwire"; letters and digits only (it is embedded in a URL): openssl rand -hex 16
OWLWIRE_DB_OWNER_PASSWORD=

# Application role (subject to row level security). `owlwire migrate` creates it with this password when it does
# not exist; an existing role's password is left untouched. Letters and digits only (it is embedded in a URL):
# openssl rand -hex 24. Upgrading an existing install: see UPGRADING.md.
OWLWIRE_DB_APP_PASSWORD=

# Local development only, never in production: "true" lets serve start when the application database role is not
# subject to row level security (single role, superuser), logging each reason as a warning. Ignored when
# NODE_ENV=production, which the Owlwire image sets. Leave it false.
OWLWIRE_ALLOW_INSECURE_DB_ROLE=false

# Instance key encryption key, base64 of 32 bytes: openssl rand -base64 32
OWLWIRE_KEK=
OWLWIRE_KEK_VERSION=1
# KEK rotation: put the new key in OWLWIRE_KEK and its version in OWLWIRE_KEK_VERSION, the old one as
# "<old version>:<base64>" in OWLWIRE_KEK_PREVIOUS, restart, run `docker compose exec owlwire owlwire keys rotate`;
# once it prints "OWLWIRE_KEK_PREVIOUS can be removed", remove OWLWIRE_KEK_PREVIOUS and restart.
OWLWIRE_KEK_PREVIOUS=

OWLWIRE_LOG_LEVEL=info
OWLWIRE_PUBLIC_URL=

# HTTP port inside the container. The compose file publishes 8080, so change its ports entry along with it.
OWLWIRE_PORT=8080
# Process role: all, api or worker. The compose file starts `serve --role all`, and --role takes precedence.
OWLWIRE_ROLE=all
# Edition config file inside the container. Empty uses /etc/owlwire/owlwire.yaml when that file exists.
OWLWIRE_CONFIG=

# Development only: token for /api/dev/* and the dev panel: openssl rand -hex 24
OWLWIRE_DEV_ADMIN_TOKEN=
# Development only (to be removed once user accounts land): 1 registers a logging fake adapter for platform "webhook"
OWLWIRE_DEV_FAKE_ADAPTER=0

# Optional shared Telegram bot (not used yet; shared bot delivery comes in a later release)
OWLWIRE_TELEGRAM_BOT_TOKEN=
